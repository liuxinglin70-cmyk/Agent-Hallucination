                    "operator": "equals",
                    "value": "true"
                  },
                  {
                    "field": "context_judge_hallucination_reason",
                    "operator": "exists"
                  }
                ],
                "verdict": "violated",
                "detail": "judge_positive=true while context_judge_hallucination_reason is non-empty: the judge's own recorded failure reason contradicts its positive conviction"
              }
            ]
          }
        },
        "claim": {
          "expected_behavior": "At defense.pre, every judge-positive packet whose own context records a hallucination reason produces the mechanical row evo_self_refuting_conviction=violated, giving adjudication a same-packet mechanical ground to withhold the conviction.",
          "target_polarity": "precision"
