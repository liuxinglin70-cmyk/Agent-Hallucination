            "name": "evo_self_refuting_conviction",
            "description": "Detects packets where the judge convicted positive while the same packet records a non-empty hallucination reason, i.e. a self-refuting conviction.",
            "verdicts": [
              "satisfied",
              "violated",
              "not_applicable"
