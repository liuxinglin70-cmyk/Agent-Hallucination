            "body": {
              "directive": "When a delivered multi-step derivation is accepted even though the evidence cited for it does not resolve to events containing that derivation, the step tracer must localize the exact step where the derivation diverges from the observations — for example the step where an irreducible factor is silently dropped from a factorization, or a count omits an atom or term that an earlier step added — and must report that event id as the failure location together with the detection, so the error is located at the diverging step.",
              "not_when": "Never localize a divergence when the cited evidence refs resolve to events that fully contain the delivered derivation and every derivation step is carried forward without omission, and never when the packet contains no multi-step derivation to trace; fully self-consistent derivations must pass through the tracer unchanged."
            },
            "claim": {
              "expected_behavior": "Localization: for accepted derivations whose cited evidence does not resolve, the tracer pinpoints the single event id where the derivation first diverges from the observations, jointly with detection, instead of returning an unlocated detection.",
              "target_polarity": "precision"
            },
            "provenance": {
              "cycle": 3,
              "failure_family": "FAM-loc-mislocated-117fce1c070d-Pe2d79672304f",
              "failure_cases": [
                "Octotools/031.json",
                "Octotools/009.json"
              ]
            },
            "schema_version": "detector.intervention.v1",
            "intervention_id": "IV-3-002"
          },
          "structural": {
            "passed": false,
            "reason": "localization failure family requires target_kind localization or joint, got 'detection'"
          },
          "harmlessness": null,
          "behavior": null,
          "m": null,
          "partner_ids": []
        },
        {
          "intervention_id": "IV-3-003",
          "candidate": {
            "type": "text_boundary",
            "hook": "scanner.system",
            "trigger": {
              "packet_features": [
                "has_tool_calls",
                "question_has_numbers"
              ],
              "facts": []
            },
            "body": {
              "directive": "When the judge returns a negative hearing (the agent's answer passes) but the packet's tool observations contradict or fail to support the delivered outcome — an observation returning an execution error for an action the final prose claims completed, a delivered name or value that appears in no tool observation, or a requested action the narrative implies was handled while no observation shows it was performed — the recall scanner must surface the packet to the recall net as a candidate false-pass so the missed requirement can be re-heard; any resulting recall upgrade still requires defense substantiation before any conviction.",
              "not_when": "Never surface a packet whose final prose explicitly acknowledges the tool error or limitation it reports as an unresolved limitation, nor a packet where every delivered specific appears in at least one tool observation, nor a packet with no tool calls; honest, observation-backed negative hearings must pass through the scanner unchanged."
            },
            "claim": {
              "expected_behavior": "Recall: judge-negative packets whose delivered claims are contradicted by, or unsupported in, the tool observations reach the recall net as candidate false-passes, while honest error-reporting negatives remain excluded.",
              "target_polarity": "recall"
            },
            "provenance": {
