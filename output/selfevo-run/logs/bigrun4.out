        {
          "intervention_id": "IV-2-002",
          "candidate": {
            "type": "text_boundary",
            "hook": "tracer.system",
            "trigger": {
              "packet_features": [
                "has_long_prose",
                "has_numeric_content",
                "has_tool_calls"
              ],
              "facts": []
            },
            "body": {
              "directive": "During step tracing, after the final delivery is formed, check the delivered result's key claim (the actor, value, or quantity it names) against the traced observations: when a traced observation asserts a different actor or value for the same question, or when the delivered quantity or its stated basis was never computed, counted, or observed in any successful traced step because the producing step failed, was abandoned, or was replaced by an unverified assumption, emit a tracer finding labeled unsupported_delivery with the contradicting or missing-step event ids and mark it so adjudication treats the positive as unconfirmed.",
              "not_when": "Do not emit the finding when a traced observation explicitly states the delivered actor, value, or quantity, when the delivery only omits optional extra detail that no contract requires, or when the traced evidence is merely incomplete about a sub-topic the question never asks for; faithful paraphrases of the final supporting observation are not findings."
            },
            "claim": {
              "expected_behavior": "the tracer surfaces trace-level contradictions and never-computed delivered claims so judge-positive hallucinated deliveries can be withheld, reducing false positives",
              "target_polarity": "precision"
            },
            "provenance": {
              "cycle": 2,
              "failure_family": "FAM-loc-mislocated-117fce1c070d-Pdc59b76d89dc",
              "failure_cases": [
                "OpenDeepSearch/079.json",
                "Magentic_One/061.json",
                "Camel/088.json"
              ]
            },
