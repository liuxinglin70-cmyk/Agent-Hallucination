        },
        {
          "intervention_id": "IV-2-003",
          "candidate": {
            "type": "text_boundary",
            "hook": "tracer.system",
            "trigger": {
              "packet_features": [
                "has_long_prose",
                "has_numeric_content",
                "has_tool_calls",
                "question_has_numbers"
              ],
              "facts": []
            },
            "body": {
              "directive": "During step tracing, verify support location for the delivered result: check that each event cited as evidence actually establishes the delivered key values, that no traced step assigns a constant or intermediate to a value that contradicts an earlier traced output, and that the delivery does not silently drop a component that a traced intermediate result established as complete; on any of these, emit a tracer finding labeled mislocated_support identifying the cited refs and the conflicting content, and mark it so adjudication cannot substantiate the positive on those refs.",
              "not_when": "Do not emit the finding when the cited events support the delivered values and no traced output contradicts them, when no evidence refs exist at all, or when the delivery is a faithful paraphrase of the final supporting step; background context the delivery builds on consistently is not a contradiction."
            },
            "claim": {
              "expected_behavior": "the tracer flags cited-but-nonsupporting evidence and silent divergences from traced intermediates so judge-positive hallucinated deliveries can be withheld, reducing false positives",
              "target_polarity": "precision"
            },
