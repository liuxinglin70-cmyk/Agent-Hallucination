{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/vgse/hazard_detector_output_schema.v1.json",
  "title": "VG-SE Hazard Detector Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "hazard_units", "abstained", "summary"],
  "properties": {
    "schema_version": {"const": "hazard_detector_output.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "hazard_units": {"type": "array", "items": {"$ref": "#/$defs/hazard_unit"}},
    "abstained": {"type": "boolean"},
    "summary": {"type": "string"}
  },
  "$defs": {
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason"],
      "properties": {
        "action": {"enum": ["allow", "verify_then_continue", "revise", "abstain_or_block"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "hazard_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "hazard_family", "construct_label", "status", "onset_event_id", "downstream_event_ids", "evidence_obligations", "witness_refs", "counter_witness_refs", "confidence", "intervention"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "hazard_family": {
          "enum": [
            "invented_repository_entity",
            "interface_signature_mismatch",
            "tool_target_or_scope_error",
            "observation_misinterpretation",
            "unavailable_api_or_dependency",
            "unreachable_or_redundant_patch",
            "requirement_patch_mismatch",
            "validation_or_completion_overreach"
          ]
        },
        "construct_label": {"enum": ["hallucination", "hallucination_linked_action_error", "ordinary_coding_error", "insufficient_evidence"]},
        "status": {"enum": ["supported_hazard", "refuted_hazard", "insufficient_evidence"]},
        "onset_event_id": {"type": ["string", "null"]},
        "downstream_event_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_obligations": {"type": "array", "items": {"type": "string"}},
        "witness_refs": {"type": "array", "items": {"type": "string"}},
        "counter_witness_refs": {"type": "array", "items": {"type": "string"}},
        "deterministic_verifier": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "intervention": {"$ref": "#/$defs/intervention"}
      }
    }
  }
}
