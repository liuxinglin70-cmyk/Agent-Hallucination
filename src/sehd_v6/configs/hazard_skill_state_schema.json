{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/vgse/hazard_skill_state_schema.v1.json",
  "title": "VG-SE Hallucination Hazard Skill",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_version", "parent_skill_hash", "hazard_rules", "boundary_rules", "intervention_policy", "rejected_buffer", "token_budget", "provenance"],
  "properties": {
    "skill_version": {"type": "string", "minLength": 1},
    "parent_skill_hash": {"type": ["string", "null"]},
    "hazard_rules": {"type": "array", "items": {"$ref": "#/$defs/hazard_rule"}},
    "boundary_rules": {"type": "array", "items": {"$ref": "#/$defs/boundary_rule"}},
    "intervention_policy": {"$ref": "#/$defs/intervention_policy"},
    "rejected_buffer": {"type": "array", "items": {"$ref": "#/$defs/rejected_candidate"}},
    "token_budget": {"type": "integer", "minimum": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_from_split", "feedback_ids", "generator_model", "prompt_hash", "parent_skill_hash", "test_feedback_used"],
      "properties": {
        "created_from_split": {"enum": ["initial", "train", "dev"]},
        "feedback_ids": {"type": "array", "items": {"type": "string"}},
        "generator_model": {"type": "string", "minLength": 1},
        "prompt_hash": {"type": "string", "minLength": 1},
        "parent_skill_hash": {"type": ["string", "null"]},
        "test_feedback_used": {"const": false}
      }
    }
  },
  "$defs": {
    "hazard_family": {
      "enum": [
        "invented_repository_entity",
        "interface_signature_mismatch",
        "tool_target_or_scope_error",
        "observation_misinterpretation",
        "unavailable_api_or_dependency",
        "unreachable_or_redundant_patch",
        "requirement_patch_mismatch",
        "validation_or_completion_overreach"
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "repo_count", "deterministic_verifier"],
      "properties": {
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "repo_count": {"type": "integer", "minimum": 0},
        "deterministic_verifier": {"type": ["string", "null"]}
      }
    },
    "hazard_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "hazard_family", "trigger", "evidence_obligations", "causal_template", "probes", "clean_counterexamples", "intervention", "applicability", "support"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "hazard_family": {
          "enum": [
            "invented_repository_entity",
            "interface_signature_mismatch",
            "tool_target_or_scope_error",
            "observation_misinterpretation",
            "unavailable_api_or_dependency",
            "unreachable_or_redundant_patch",
            "requirement_patch_mismatch",
            "validation_or_completion_overreach"
          ]
        },
        "trigger": {"type": "string", "minLength": 1},
        "evidence_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "causal_template": {"type": "string", "minLength": 1},
        "probes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "clean_counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "intervention": {"enum": ["allow", "verify_then_continue", "revise", "abstain_or_block"]},
        "applicability": {"type": "string", "minLength": 1},
        "support": {"$ref": "#/$defs/support"}
      }
    },
    "boundary_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "condition", "construct_label", "action"],
      "properties": {
        "boundary_id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "construct_label": {"enum": ["ordinary_coding_error", "insufficient_evidence", "hallucination", "hallucination_linked_action_error"]},
        "action": {"enum": ["allow", "verify_then_continue", "revise", "abstain_or_block"]}
      }
    },
    "intervention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "minimum_supported_confidence", "abstain_when_evidence_insufficient", "high_risk_boundaries"],
      "properties": {
        "allowed_actions": {"type": "array", "items": {"enum": ["allow", "verify_then_continue", "revise", "abstain_or_block"]}},
        "minimum_supported_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "abstain_when_evidence_insufficient": {"const": true},
        "high_risk_boundaries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rejected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_hash", "reason", "source_feedback_ids"],
      "properties": {
        "candidate_hash": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_feedback_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
