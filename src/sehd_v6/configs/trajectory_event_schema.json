{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/vgse/trajectory_event_schema.v1.json",
  "title": "VG-SE Trajectory Event Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "events", "relations", "metadata"],
  "properties": {
    "schema_version": {"const": "trajectory_event_graph.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_schema_version", "repo_group_key", "eventizer_version", "outcome_fields_used_as_labels"],
      "properties": {
        "source_schema_version": {"type": ["string", "null"]},
        "repo_group_key": {"type": "string", "minLength": 1},
        "eventizer_version": {"const": "v1"},
        "outcome_fields_used_as_labels": {"const": false}
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "message_index", "sub_index"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "message_index": {"type": ["integer", "null"], "minimum": 0},
        "sub_index": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "locator", "payload", "raw_sha256"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "event_type": {
          "enum": ["belief", "plan", "action", "tool_call", "observation", "interpretation", "patch", "validation", "claim"]
        },
        "locator": {"$ref": "#/$defs/locator"},
        "payload": {"type": "object"},
        "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "relation_type", "source_event_id", "target_event_id", "evidence_refs"],
      "properties": {
        "relation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "relation_type": {
          "enum": ["supports", "contradicts", "causes", "depends_on", "modifies", "validates", "claims_effect_of", "invokes", "produces", "follows"]
        },
        "source_event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "target_event_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
