{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/vgse/skill_state_schema.v1.json",
  "title": "VG-SE Auditable Skill State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_version",
    "claim_patterns",
    "evidence_obligations",
    "counter_witness_templates",
    "boundary_memory",
    "routing_rules",
    "calibration",
    "provenance"
  ],
  "properties": {
    "skill_version": {"type": "string", "minLength": 1},
    "parent_skill_hash": {"type": ["string", "null"]},
    "claim_patterns": {"type": "array", "items": {"type": "object"}},
    "evidence_obligations": {"type": "array", "items": {"type": "object"}},
    "counter_witness_templates": {"type": "array", "items": {"type": "string"}},
    "boundary_memory": {"type": "array", "items": {"type": "object"}},
    "routing_rules": {"type": "array", "items": {"type": "object"}},
    "calibration": {
      "type": "object",
      "required": ["abstain_when_evidence_insufficient", "confidence_policy"],
      "properties": {
        "abstain_when_evidence_insufficient": {"const": true},
        "confidence_policy": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_from_split", "feedback_ids", "generator_model", "prompt_hash"],
      "properties": {
        "created_from_split": {"enum": ["initial", "train", "dev"]},
        "feedback_ids": {"type": "array", "items": {"type": "string"}},
        "generator_model": {"type": "string"},
        "prompt_hash": {"type": "string"}
      }
    }
  }
}
