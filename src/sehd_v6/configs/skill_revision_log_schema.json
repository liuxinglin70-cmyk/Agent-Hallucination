{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/vgse/skill_revision_log_schema.v1.json",
  "title": "VG-SE Skill Revision Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "parent_skill_hash",
    "candidate_skill_hash",
    "proposal_source",
    "changed_objects",
    "train_feedback_ids",
    "dev_gate",
    "decision",
    "test_feedback_used"
  ],
  "properties": {
    "revision_id": {"type": "string"},
    "parent_skill_hash": {"type": "string"},
    "candidate_skill_hash": {"type": "string"},
    "proposal_source": {"enum": ["train_feedback", "manual_seed", "verifier_failure_analysis"]},
    "changed_objects": {"type": "array", "items": {"type": "object"}},
    "train_feedback_ids": {"type": "array", "items": {"type": "string"}},
    "dev_gate": {
      "type": "object",
      "required": ["config_hash", "metrics_before", "metrics_after", "guardrails_passed"]
    },
    "decision": {"enum": ["accepted", "rejected"]},
    "test_feedback_used": {"const": false}
  }
}
