{
  "schema_version": "detector.config.v1",
  "case_timeout_seconds": 10800,
  "causal_audit": {
    "mode": "tracer_context",
    "score_source": "semantic_proxy",
    "policy_version": "dataset-origin-risk-v2",
    "max_added_prompt_tokens_per_case": 24000,
    "counterfactual_mode": "deterministic_only",
    "negative_feedback_enabled": false
  },
  "provider": {
    "endpoint": "https://www.autodl.art/api/v1",
    "model": "GLM-5.3-flash",
    "api_key_env": "AUTODL_API_KEY",
    "temperature": 0.0,
    "timeout_seconds": 900,
    "total_timeout_seconds": 2400,
    "transport_retries": 2,
    "timeout_growth_factor": 1.5,
    "context_cache": {
      "enabled": true,
      "mode": "automatic"
    }
  },
  "judge_route": {
    "model": "GLM-5.3-flash",
    "json_mode": true,
    "votes": 3,
    "vote_topup": 2
  },
  "defense_route": {
    "model": "GLM-5.3-flash",
    "votes": 3,
    "vote_topup": 2
  },
  "recall_route": {
    "model": "GLM-5.3-flash"
  }
}
