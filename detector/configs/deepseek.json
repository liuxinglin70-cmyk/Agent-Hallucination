{
  "schema_version": "detector.config.v1",
  "causal_audit": {
    "next_action_mode": "judge_context",
    "max_added_provider_requests_per_case": 2,
    "max_added_prompt_tokens_per_case": 60000,
    "max_added_output_tokens_per_case": 8192,
    "max_added_seconds_per_case": 180
  },
  "provider": {
    "endpoint": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.0,
    "timeout_seconds": 240,
    "total_timeout_seconds": 480,
    "transport_retries": 2,
    "timeout_growth_factor": 1.5,
    "context_cache": {
      "enabled": true,
      "mode": "automatic"
    },
    "extra_body": {
      "thinking": {
        "type": "disabled"
      }
    }
  },
  "judge_route": {
    "model": "deepseek-v4-pro"
  },
  "defense_route": {
    "model": "deepseek-v4-pro"
  },
  "recall_route": {
    "model": "deepseek-v4-flash"
  }
}
